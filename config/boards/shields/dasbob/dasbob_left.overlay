/*
 * Dasbob Left Half — nice!nano v2 clone, handwired
 *
 * Assumed pinout (controller at right of left half, facing up, USB at top):
 *
 *   ROWS — BAT- side (right column of nice!nano), first GPIO down from VCC:
 *     Row 0  top row      P0.06
 *     Row 1  middle row   P0.08
 *     Row 2  bottom row   P0.17
 *     Row 3  thumb row    P0.20
 *
 *   COLS — BAT+ side (left column of nice!nano), first GPIO down from VCC:
 *     Col 0  outermost    P0.31
 *     Col 1               P0.29
 *     Col 2               P0.02
 *     Col 3               P1.15
 *     Col 4  innermost    P1.13
 *
 *   Thumb keys assumed in row 3, cols 2/3/4 (inner three columns).
 *   If thumbs are wired to cols 0/1/2 or 1/2/3, update the transform map below.
 *
 *   Diode direction: col2row (cathode/stripe toward row wire — standard handwired).
 *   If every key fires on release instead of press, swap to "row2col".
 *   If a row fires all keys at once, row/col wires may be swapped — swap the
 *   row-gpios and col-gpios pin lists and toggle diode-direction.
 */

#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };

    /*
     * Full 36-key transform (left + right halves).
     * columns=10: left uses cols 0-4, right uses cols 5-9 (ZMK adds offset automatically).
     *
     * Right col 0 = innermost right key (nearest center split).
     * If your right half has the controller on the opposite side, reverse the
     * right-side rows in the map: swap RC(r,5)..RC(r,9) to RC(r,9)..RC(r,5).
     */
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)    RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)    RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)    RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
                            RC(3,2) RC(3,3) RC(3,4)    RC(3,5) RC(3,6) RC(3,7)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";

        row-gpios
            = <&gpio0 6  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* Row 0 — top row    */
            , <&gpio0 8  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* Row 1 — middle row */
            , <&gpio0 17 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* Row 2 — bottom row */
            , <&gpio0 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* Row 3 — thumb row  */
            ;

        col-gpios
            = <&gpio0 31 GPIO_ACTIVE_HIGH>  /* Col 0 — outermost */
            , <&gpio0 29 GPIO_ACTIVE_HIGH>  /* Col 1             */
            , <&gpio0 2  GPIO_ACTIVE_HIGH>  /* Col 2             */
            , <&gpio1 15 GPIO_ACTIVE_HIGH>  /* Col 3             */
            , <&gpio1 13 GPIO_ACTIVE_HIGH>  /* Col 4 — innermost */
            ;
    };
};
